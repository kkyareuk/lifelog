rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function activeAccount(){ return request.auth != null && !firestore.exists(/databases/(default)/documents/deletedAccounts/$(request.auth.uid)); }
    match /users/{userId}/{allPaths=**} {
      allow read: if activeAccount() && request.auth.uid == userId;
      allow delete: if activeAccount() && request.auth.uid == userId;
      allow create, update: if activeAccount()
        && request.auth.uid == userId
        && request.resource.size <= 1572864
        && request.resource.contentType.matches('image/.*');
    }
  }
}
