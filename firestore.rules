rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && !exists(/databases/$(database)/documents/deletedAccounts/$(request.auth.uid));
    }

    function groupDocument(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function groupDocumentAfter(groupId) {
      return getAfter(/databases/$(database)/documents/groups/$(groupId));
    }

    function hasGroupMembership(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function groupRole(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role;
    }

    function isGroupOwner(groupId) {
      return signedIn() && groupDocument(groupId).data.ownerUid == request.auth.uid;
    }

    function isGroupManager(groupId) {
      return isGroupOwner(groupId)
        || (hasGroupMembership(groupId) && groupRole(groupId) in ['owner', 'manager']);
    }

    match /users/{userId} {
      allow read:
        if signedIn() && request.auth.uid == userId;

      // 이용권은 관리자 콘솔·결제 서버만 부여합니다.
      // 일반 사용자는 자기 게임 데이터는 저장할 수 있지만 이용권을 만들거나 바꿀 수 없습니다.
      allow create:
        if signedIn()
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['entitlements']);

      allow update:
        if signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['entitlements']);

      allow delete:
        if signedIn() && request.auth.uid == userId;
    }

    // 게임 본문은 1MB 문서 한도를 피하기 위해 정해진 동기화 문서에만 나눠
    // 저장한다. 사용자는 자기 UID 아래에서도 앱이 쓰지 않는 임의의 하위
    // 문서를 만들 수 없다.
    match /users/{userId}/sync/{syncDocument} {
      allow read, create, update, delete:
        if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/characters/{characterId} {
      allow read, create, update, delete:
        if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/characters/{characterId}/days/{dateId} {
      allow read, create, update, delete:
        if signedIn() && request.auth.uid == userId;
    }

    // 사용자의 그룹 목록 색인이다. 다른 사용자의 색인은 그룹 관리자도
    // 해당 사용자를 그룹에서 내보내는 삭제 작업에만 접근할 수 있다.
    match /users/{userId}/groupMemberships/{groupId} {
      allow read, create, update:
        if signedIn() && request.auth.uid == userId;
      allow delete:
        if signedIn() && (request.auth.uid == userId || isGroupManager(groupId));
    }

    match /groups/{groupId} {
      allow create:
        if signedIn()
        && !exists(/databases/$(database)/documents/deletedGroups/$(groupId))
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow read:
        if signedIn()
        && (resource.data.ownerUid == request.auth.uid || hasGroupMembership(groupId));
      allow update:
        if isGroupManager(groupId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lifeUpdatedAt', 'buildingRevision'])
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete:
        if isGroupOwner(groupId);

      match /members/{memberId} {
        allow read:
          if hasGroupMembership(groupId) || isGroupOwner(groupId);
        allow create:
          if signedIn()
          && request.resource.data.uid == memberId
          && (
            (memberId == request.auth.uid
              && groupDocumentAfter(groupId).data.ownerUid == request.auth.uid
              && request.resource.data.role == 'owner')
            ||
            (memberId == request.auth.uid
              && request.resource.data.role == 'member'
              && request.resource.data.inviteCode is string
              && exists(/databases/$(database)/documents/groupInvites/$(request.resource.data.inviteCode))
              && get(/databases/$(database)/documents/groupInvites/$(request.resource.data.inviteCode)).data.active == true
              && get(/databases/$(database)/documents/groupInvites/$(request.resource.data.inviteCode)).data.groupId == groupId)
          );
        allow update:
          if isGroupManager(groupId)
          && resource.data.uid == request.resource.data.uid
          && (resource.data.role != 'owner' || isGroupOwner(groupId))
          || (signedIn() && memberId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL'])
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 20
            && request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 2000);
        allow delete:
          if signedIn()
          && (memberId == request.auth.uid || isGroupManager(groupId))
          && resource.data.role != 'owner';
      }

      match /mail/{id} { allow read: if hasGroupMembership(groupId) && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid); }
      match /schedules/{id} { allow read: if hasGroupMembership(groupId); }
      match /characterGroups/{id} { allow read: if hasGroupMembership(groupId); }
      match /relationships/{id} {
        allow read: if hasGroupMembership(groupId);
      }
      match /catalog/{id} {
        allow read: if hasGroupMembership(groupId);
      }
      match /perceptions/{id} {
        allow read: if hasGroupMembership(groupId);
      }
      match /declarations/{id} {
        allow read: if hasGroupMembership(groupId);
      }
      match /proposals/{id} {
        allow read: if hasGroupMembership(groupId)
          && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      }
      match /residents/{residentId} {
        allow read: if hasGroupMembership(groupId) || isGroupOwner(groupId);
        allow create:
          if hasGroupMembership(groupId)
          && request.resource.data.ownerUid == request.auth.uid
          && !request.resource.data.keys().hasAny(['lifeJson', 'commandAt'])
          && request.resource.data.sourceCharacterId is string;
        allow update:
          if (resource.data.ownerUid == request.auth.uid || isGroupManager(groupId))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lifeJson', 'commandAt'])
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.sourceCharacterId == resource.data.sourceCharacterId;
        allow delete:
          if resource.data.ownerUid == request.auth.uid || isGroupManager(groupId);
      }

      match /homes/{homeId} {
        allow read: if hasGroupMembership(groupId) || isGroupOwner(groupId);
        allow create:
          if hasGroupMembership(groupId)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.sourceHomeId is string;
        allow update:
          if (resource.data.ownerUid == request.auth.uid || isGroupManager(groupId))
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.sourceHomeId == resource.data.sourceHomeId;
        allow delete:
          if resource.data.ownerUid == request.auth.uid || isGroupManager(groupId);
      }
    }

    // 초대 코드는 로그인한 사용자가 정확한 코드를 입력했을 때만 단건으로
    // 읽는다. 목록 조회 규칙은 없으며 생성·교체·폐기는 그룹 관리자만 한다.
    match /groupInvites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create:
        if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && groupDocumentAfter(request.resource.data.groupId).data.ownerUid == request.auth.uid;
      allow update, delete:
        if isGroupManager(resource.data.groupId);
    }

    match /feedback/{feedbackId} {
      allow create:
        if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 3000
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 40;

      // 피드백은 개발자만 Firebase 콘솔에서 확인합니다.
      allow read, update, delete: if false;
    }
  }
}
