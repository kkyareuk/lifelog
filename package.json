{
  "name": "drawer-village-android",
  "version": "1.0.0",
  "private": true,
  "description": "서랍마을 Android 앱 패키지",
  "scripts": {
    "build": "node scripts/prepare-web.mjs",
    "pages:build": "node scripts/prepare-web.mjs",
    "postinstall": "patch-package",
    "app:prepare": "node scripts/prepare-app.mjs && node scripts/check-native-module-closure.mjs && node scripts/check-android-build-assets.mjs",
    "cap:sync:android": "node --require ./scripts/windows-userinfo-shim.cjs ./node_modules/@capacitor/cli/bin/capacitor sync android",
    "app:sync": "npm run app:prepare && npm run cap:sync:android",
    "app:open": "npm run app:sync && cap open android",
    "app:build:debug": "npm run app:sync && cd android && gradlew.bat assembleDebug",
    "app:build:bundle": "npm run app:sync && cd android && gradlew.bat bundleRelease",
    "test:ime": "node scripts/check-ime-editor-stability.mjs",
    "test:lifecycle": "node scripts/check-new-character-lifecycle.mjs",
    "test:character-ui": "node scripts/check-character-editor-ui-stability.mjs",
    "test:notifications": "node scripts/check-character-notifications.mjs",
    "test:catalog-routine": "node scripts/check-catalog-routine-stability.mjs",
    "test:navigation": "node scripts/check-navigation-event-boundary.mjs",
    "test:media-home-routine": "node scripts/check-media-home-routine-features.mjs",
    "test:cloud-merge": "node scripts/check-cloud-character-merge.mjs",
    "test:log-continuity": "node scripts/check-log-sync-continuity.mjs",
    "test:backup-home-scene": "node scripts/check-backup-home-scene-stability.mjs",
    "test:observe-hud": "node scripts/check-observe-game-hud.mjs",
    "test:selection-continuity": "node scripts/check-selection-continuity.mjs",
    "test:character-wallet": "node scripts/check-character-wallet-scene-integrity.mjs",
    "test:android-assets": "node scripts/check-android-build-assets.mjs",
    "test:date-schedule-companion": "node scripts/check-game-date-schedule-companion.mjs",
    "test:forward-schema-recovery": "node scripts/check-forward-schema-recovery.mjs",
    "test:character-group-layout": "node scripts/check-character-group-layout.mjs",
    "test:performance": "node scripts/check-performance-stability.mjs",
    "test:home-life": "node scripts/check-home-life-simulation.mjs",
    "test:home-surfaces": "node scripts/check-home-surfaces.mjs",
    "test:hotfix-schedule-deletion": "node scripts/check-schedule-deletion-sync.mjs",
    "test:town-grid": "node scripts/check-town-grid-editor.mjs",
    "test:town-profile": "node scripts/check-town-profile-bugfixes.mjs",
    "test:shop-billing": "node scripts/check-native-shop-billing.mjs",
    "test:reported-bugs": "node scripts/check-reported-bug-fixes.mjs",
    "test:layout180": "node scripts/check-layout-180.mjs",
    "test:account-isolation": "node scripts/check-account-isolation.mjs",
    "test:town-lighting": "node scripts/check-town-lighting.mjs",
    "test:restore-storage": "node scripts/check-restore-storage.mjs",
    "test:directed-gifts": "node scripts/check-directed-gifts.mjs",
    "test:management183": "node scripts/check-management-183.mjs",
    "test:dictionary184": "node scripts/check-dictionary-mail-184.mjs",
    "test:village185": "node scripts/check-village-185.mjs",
    "test:village186": "node scripts/check-village-186.mjs",
    "test:village187": "node scripts/check-village-187.mjs",
    "test:village188": "node scripts/check-village-188.mjs",
    "test:village189": "node scripts/check-village-189.mjs",
    "test:character190": "node scripts/check-character-emotion-190.mjs",
    "test:statistics191": "node scripts/check-statistics-emotion-191.mjs",
    "test:layout-meals192": "node scripts/check-direct-layout-meals-192.mjs",
    "test:achievements193": "node scripts/check-play-games-achievements-193.mjs",
    "test:taste-scroll194": "node scripts/check-character-taste-scroll-194.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^7.5.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/network": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "firebase": "^11.10.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "patch-package": "^8.0.1"
  }
}
